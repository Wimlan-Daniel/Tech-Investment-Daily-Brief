# dependencies
/node_modules

# OS
.DS_Store

# env files
.env*
!.env.example

# trending pipeline output (each fork generates its own)
/daily_reports/

# docs/ 是发布给 GitHub Pages 的网页，必须进版本管理
# （daily_reports 与 每日资讯留档 仍然排除：那里有 JSON 中间数据）
!/docs/
/logs/

# Claude Code local state (skills + commands ARE committed; cache/state aren't)
/.claude/state/
/.claude/cache/

# typescript
*.tsbuildinfo

# screenshot originals (only the cropped versions are committed)
/docs/screenshots/originals/

# 运行产物
output/
logs/
每日资讯留档/

# 生成的文档
*.docx
